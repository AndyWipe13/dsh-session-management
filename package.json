{
  "name": "@dsh-external/dsh-session-management",
  "version": "0.0.1",
  "description": "Manage DeepSeek Harness sessions: delete legacy sessions and import sessions from Claude Code/Codex",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "client.js",
    "client.d.ts"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc <2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "pretest": "npm run build",
    "test": "node --test --test-isolation=none \"test/*.test.js\"",
    "pretypecheck": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}